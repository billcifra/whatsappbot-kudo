# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Token que se pone en Meta al configurar el webhook (antes fijo en el código: "mibotverificacion")
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256 de cada webhook
WHATSAPP_APP_SECRET=
# GRAPH_API_VERSION=v18.0

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODELO=gpt-4.1
# Precios por millón de tokens, para estimar el costo en el panel
# PRECIO_ENTRADA_USD_M=2.0
# PRECIO_SALIDA_USD_M=8.0

# --- Base de datos ---
# En Railway: DATA_DIR=/data (ya viene en el Dockerfile) con un Volume montado en /data.
# En local, si no se define, se usa ./data
# DATA_DIR=

# --- Google Sheets (copia secundaria) ---
GOOGLE_SHEET_KEY=
# JSON completo de la cuenta de servicio, en una línea. En local puede omitirse si existe credentials.json
GOOGLE_CREDENTIALS_JSON=

# --- Equipo ---
# Números que reciben el aviso de "atención humana", separados por coma
NUMEROS_PERSONAL=59179598641,59176785574
# Horas que se pausa el bot cuando el agente deriva a una persona (0 = no pausa)
PAUSA_DERIVACION_HORAS=0
# Horas que se pausa el bot al responder desde el panel
PAUSA_RESPUESTA_HORAS=12

# --- Panel (/panel) ---
# Primer usuario: se crea al arrancar si no hay ninguno (usuario en minúsculas, clave de 10+ caracteres)
PANEL_USUARIO_INICIAL=
PANEL_CLAVE_INICIAL=
# En local (http://localhost) poner false; en Railway (https) dejar true
# PANEL_COOKIE_SEGURA=true

# --- Tareas únicas al arrancar (se marcan como hechas en la base y no se repiten) ---
# Migración desde el Redis anterior. En Railway, si no se define, usa REDIS_URL. Vacía = desactivada.
# MIGRAR_DESDE_REDIS_URL=redis://default:...@redis.railway.internal:6379
# Importa el histórico de las hojas Interesados y SolicitudesHumano (después de la migración de Redis)
# IMPORTAR_HISTORICO_SHEETS=true
